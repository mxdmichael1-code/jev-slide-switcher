# Doubao vision-capable model name or your Ark endpoint ID (ep-...).
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-1-pro-260628
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
# Absolute path to the existing, working Moonshine v0.1.5 web project.
MOONSHINE_ROOT=/absolute/path/to/moonshine-local
# Install LibreOffice if soffice is not on PATH; set its executable here.
SOFFICE_PATH=
VISION_BATCH_SIZE=1
VISION_TIMEOUT_SECONDS=120
JEV_TIMEOUT_SECONDS=8
# Optional explicit reuse of existing .env files instead of copying their keys:
# DOUBAO_ENV_FILE=/absolute/path/to/existing-project/.env
# JEV_ENV_FILE=/absolute/path/to/jev-network-monitor/.env
# Leave 0 to assign a free loopback port to each presentation session.
BRIDGE_PORT=0
